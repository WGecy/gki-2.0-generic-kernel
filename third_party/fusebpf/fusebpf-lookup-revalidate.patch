+static int bpf_map_set_u32(int map_fd, uint32_t key, uint32_t value)
+{
+	union bpf_attr attr = {
+		.map_fd = map_fd,
+		.key = ptr_to_u64(&key),
+		.value = ptr_to_u64(&value),
+		.flags = BPF_ANY,
+	};
+
+	return syscall(__NR_bpf, BPF_MAP_UPDATE_ELEM, &attr, sizeof(attr));
+}
+
+static int bpf_test_lookup_revalidate(const char *mount_dir)
+{
+	const char *package = "com.example.package";
+	int result = TEST_FAILURE;
+	int bpf_fd = -1;
+	int src_fd = -1;
+	int fuse_dev = -1;
+	int package_fd = -1;
+	int visibility_map_fd = -1;
+	struct map_relocation *map_relocations = NULL;
+	size_t map_count = 0;
+	struct stat st;
+	uint32_t key = 0;
+	uint32_t hidden = 0;
+
+	TEST(src_fd = open(ft_src, O_DIRECTORY | O_RDONLY | O_CLOEXEC),
+	     src_fd != -1);
+	TESTSYSCALL(mkdirat(src_fd, package, 0777));
+	TESTEQUAL(install_elf_bpf("test_bpf.bpf", "test_lookup_revalidate",
+				  &bpf_fd, &map_relocations, &map_count), 0);
+	for (size_t i = 0; i < map_count; ++i)
+		if (!strcmp(map_relocations[i].name, "lookup_visibility"))
+			visibility_map_fd = map_relocations[i].fd;
+	TESTNE(visibility_map_fd, -1);
+	TESTEQUAL(bpf_map_set_u32(visibility_map_fd, key, hidden), 0);
+	TESTEQUAL(mount_fuse(mount_dir, bpf_fd, src_fd, &fuse_dev), 0);
+
+	TESTSYSCALL(s_stat(s_path(s(mount_dir), s(package)), &st));
+	/* Keep the positive dentry in use while its visibility changes. */
+	TEST(package_fd = s_open(s_path(s(mount_dir), s(package)),
+				 O_DIRECTORY | O_RDONLY), package_fd != -1);
+	hidden = 1;
+	TESTEQUAL(bpf_map_set_u32(visibility_map_fd, key, hidden), 0);
+	TESTEQUAL(s_stat(s_path(s(mount_dir), s(package)), &st), -1);
+	TESTEQUAL(errno, ENOENT);
+	hidden = 0;
+	TESTEQUAL(bpf_map_set_u32(visibility_map_fd, key, hidden), 0);
+	TESTSYSCALL(s_stat(s_path(s(mount_dir), s(package)), &st));
+
+	result = TEST_SUCCESS;
+out:
+	close(package_fd);
+	close(fuse_dev);
+	umount(mount_dir);
+	close(bpf_fd);
+	close(src_fd);
+	for (size_t i = 0; i < map_count; ++i) {
+		free(map_relocations[i].name);
+		close(map_relocations[i].fd);
+	}
+	free(map_relocations);
+	return result;
+}
