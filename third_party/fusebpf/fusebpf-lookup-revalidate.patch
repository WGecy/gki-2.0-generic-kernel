+int fuse_lookup_revalidate_initialize(struct fuse_bpf_args *fa,
+		struct fuse_lookup_revalidate_io *fli, struct inode *dir,
+		struct dentry *entry, unsigned int flags)
+{
+	*fli = (struct fuse_lookup_revalidate_io) {};
+	*fa = (struct fuse_bpf_args) {
+		.nodeid = get_fuse_inode(dir)->nodeid,
+		.opcode = FUSE_LOOKUP,
+		.in_numargs = 1,
+		.out_numargs = 2,
+		.flags = FUSE_BPF_OUT_ARGVAR,
+		.in_args[0] = (struct fuse_bpf_in_arg) {
+			.size = entry->d_name.len + 1,
+			.value = entry->d_name.name,
+		},
+		.out_args[0] = (struct fuse_bpf_arg) {
+			.size = sizeof(fli->feo),
+			.value = &fli->feo,
+		},
+		.out_args[1] = (struct fuse_bpf_arg) {
+			.size = sizeof(fli->feb.out),
+			.value = &fli->feb.out,
+		},
+	};
+
+	return 0;
+}
+
+int fuse_lookup_revalidate_backing(struct fuse_bpf_args *fa,
+		struct inode *dir, struct dentry *entry, unsigned int flags)
+{
+	struct fuse_lookup_revalidate_io *fli = container_of(
+		fa->out_args[0].value, struct fuse_lookup_revalidate_io, feo);
+	struct fuse_dentry *dir_fuse_entry = get_fuse_dentry(entry->d_parent);
+	struct fuse_entry_out *feo = (void *)fa->out_args[0].value;
+	struct path backing_parent_path;
+	struct dentry *backing_entry;
+	struct inode *backing_inode;
+	struct kstat stat;
+	int err;
+
+	if (!dir_fuse_entry || !dir_fuse_entry->backing_path.dentry) {
+		fa->error_in = -ENOENT;
+		return -ENOENT;
+	}
+
+	get_fuse_backing_path(entry->d_parent, &backing_parent_path);
+	if (!backing_parent_path.dentry) {
+		fa->error_in = -ENOENT;
+		return -ENOENT;
+	}
+	backing_inode = d_inode(backing_parent_path.dentry);
+	if (!backing_inode) {
+		path_put(&backing_parent_path);
+		fa->error_in = -ENOENT;
+		return -ENOENT;
+	}
+
+	inode_lock_nested(backing_inode, I_MUTEX_PARENT);
+	backing_entry = lookup_one_qstr_excl(&entry->d_name,
+					    backing_parent_path.dentry, flags);
+	inode_unlock(backing_inode);
+	if (IS_ERR(backing_entry)) {
+		err = PTR_ERR(backing_entry);
+		path_put(&backing_parent_path);
+		return err;
+	}
+
+	fli->backing_path = (struct path) {
+		.dentry = backing_entry,
+		.mnt = mntget(backing_parent_path.mnt),
+	};
+	path_put(&backing_parent_path);
+
+	if (d_is_negative(backing_entry)) {
+		fa->error_in = -ENOENT;
+		return -ENOENT;
+	}
+
+	err = follow_down(&fli->backing_path, 0);
+	if (err)
+		return err;
+
+	err = vfs_getattr(&fli->backing_path, &stat, STATX_BASIC_STATS, 0);
+	if (err)
+		return err;
+
+	fuse_stat_to_attr(get_fuse_conn(dir), d_inode(fli->backing_path.dentry),
+			  &stat, &feo->attr);
+	return 0;
+}
+
+void *fuse_lookup_revalidate_finalize(struct fuse_bpf_args *fa,
+		struct inode *dir, struct dentry *entry, unsigned int flags)
+{
+	struct fuse_lookup_revalidate_io *fli;
+	struct fuse_entry_bpf_out *febo;
+	struct fuse_entry_bpf *feb;
+	struct fuse_dentry *fuse_entry;
+	struct fuse_inode *fi;
+	void *ret = NULL;
+
+	/* The prefilter path has not restored the output arguments yet. */
+	if (fa->opcode & FUSE_PREFILTER)
+		return NULL;
+
+	fli = container_of(fa->out_args[0].value,
+				  struct fuse_lookup_revalidate_io, feo);
+	febo = fa->out_args[1].value;
+	feb = container_of(febo, struct fuse_entry_bpf, out);
+	fuse_entry = get_fuse_dentry(entry);
+	fi = d_inode(entry) ? get_fuse_inode(d_inode(entry)) : NULL;
+
+	if (d_inode(entry) && fli->backing_path.dentry) {
+		switch (feb->out.backing_action) {
+		case FUSE_ACTION_KEEP:
+			if (!fi || !fi->backing_inode || !fuse_entry ||
+			    !fuse_entry->backing_path.dentry ||
+			    fi->backing_inode != d_inode(fli->backing_path.dentry) ||
+			    !path_equal(&fuse_entry->backing_path,
+					&fli->backing_path))
+				ret = ERR_PTR(-ENOENT);
+			break;
+		case FUSE_ACTION_REMOVE:
+			if ((fi && fi->backing_inode) ||
+			    (fuse_entry && fuse_entry->backing_path.dentry))
+				ret = ERR_PTR(-ENOENT);
+			break;
+		case FUSE_ACTION_REPLACE:
+			if (!feb->backing_file || IS_ERR(feb->backing_file) ||
+			    !fuse_entry || !fi ||
+			    fi->backing_inode != feb->backing_file->f_inode ||
+			    !path_equal(&fuse_entry->backing_path,
+					&feb->backing_file->f_path))
+				ret = ERR_PTR(-ENOENT);
+			break;
+		default:
+			ret = ERR_PTR(-ENOENT);
+		}
+	}
+
+	if (feb->backing_file && !IS_ERR(feb->backing_file))
+		fput(feb->backing_file);
+	path_put_init(&fli->backing_path);
+	return ret;
+}
