From 758adb4c1d9abee6ff59c5e51f26bbe85241c079 Mon Sep 17 00:00:00 2001
From: gki <gki@localhost>
Date: Sun, 20 Sep 2026 18:55:03 +0800
Subject: [PATCH 1/3] GKI: bypass module vermagic+CRC checks; fix extract-cert
 OpenSSL3 build

---
 kernel/module/version.c | 11 ++++++-----
 1 file changed, 6 insertions(+), 5 deletions(-)

diff --git a/kernel/module/version.c b/kernel/module/version.c
index 53f43ac5a73e9..2688d14aa01ff 100644
--- a/kernel/module/version.c
+++ b/kernel/module/version.c
@@ -20,6 +20,9 @@ int check_version(const struct load_info *info,
 	unsigned int i, num_versions;
 	struct modversion_info *versions;
 
+	/* [GKI] 绕过符号 CRC 校验：vendor 模块基于 stock 6.6.118 编译，直接放行 */
+	return 1;
+
 	/* Exporting module didn't supply crcs?  OK, we're already tainted. */
 	if (!crc)
 		return 1;
@@ -80,11 +83,9 @@ int check_modstruct_version(const struct load_info *info,
 int same_magic(const char *amagic, const char *bmagic,
 	       bool has_crcs)
 {
-	if (has_crcs) {
-		amagic += strcspn(amagic, " ");
-		bmagic += strcspn(bmagic, " ");
-	}
-	return strcmp(amagic, bmagic) == 0;
+	/* [GKI] 绕过 vermagic 校验：跨 stable 版本加载 vendor 模块 */
+	(void)amagic; (void)bmagic; (void)has_crcs;
+	return 1;
 }
 
